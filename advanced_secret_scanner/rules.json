{
  "rules": [
    {
      "id": "AWS_ACCESS_KEY_ID",
      "name": "AWS Access Key ID",
      "regex": "(?i)AKIA[0-9A-Z]{16}",
      "type": "aws"
    },
    {
      "id": "GITHUB_PAT",
      "name": "GitHub Personal Access Token",
      "regex": "ghp_[0-9a-zA-Z]{36}",
      "type": "github"
    },
    {
      "id": "GITLAB_PAT",
      "name": "GitLab Personal Access Token",
      "regex": "glpat-[0-9a-zA-Z_\\-\\.]{20,}",
      "type": "gitlab"
    },
    {
      "id": "GENERIC_API_KEY",
      "name": "Generic API Key",
      "regex": "(?i)(?:api_key|apikey|secret|token|password)[\\s:=]+['\"]([a-zA-Z0-9_\\-]{20,})['\"]",
      "type": "generic"
    },
    {
      "id": "PRIVATE_KEY",
      "name": "Private Key (RSA/EC)",
      "regex": "-----BEGIN (?:RSA |EC |DSA )?PRIVATE KEY-----",
      "type": "generic"
    }
  ]
}
